<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/headerStart</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <!-- 흰색 둥근 카드 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:outlineSpotShadowColor">@color/shadow</item>
        <item name="android:outlineAmbientShadowColor">@color/shadow</item>
    </style>

    <!-- 카드 머리: 아이콘 동그라미 + 제목 -->
    <style name="CardHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="IconCircle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/icon_circle</item>
        <item name="android:tint">@color/primary</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="BtnLight" parent="Btn">
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/btn_light</item>
    </style>

    <!-- 설정 목록 한 줄: 아이콘 + 글자 + 화살표 -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RowIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/icon_circle</item>
        <item name="android:tint">@color/primary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="RowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="RowChevron">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">@color/chevron</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:fillViewport">true</item>
        <item name="android:overScrollMode">ifContentScrolls</item>
    </style>

    <style name="ScreenBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- 안내 상자 (i 아이콘) -->
    <style name="InfoCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/info_bg</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="InfoIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:src">@drawable/ic_info</item>
        <item name="android:tint">@color/primary2</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <style name="InfoText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#3D3A5C</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
