<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#B9B4F2" /><corners android:radius="30dp" /></shape>
    </item>
    <item>
        <ripple android:color="#40FFFFFF">
            <item>
                <shape>
                    <gradient android:angle="0" android:startColor="@color/primary" android:endColor="@color/primary2" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
