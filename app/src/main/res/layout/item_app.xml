<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:paddingHorizontal="16dp" android:minHeight="56dp">
    <ImageView android:id="@+id/ivIcon" android:layout_width="36dp" android:layout_height="36dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/text"
        android:layout_marginStart="14dp" />
    <CheckBox android:id="@+id/cb" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
</LinearLayout>
